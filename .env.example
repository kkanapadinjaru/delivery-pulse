# Azure DevOps Configuration
# Org URL should be just the organization URL, without the project name
# Example: https://dev.azure.com/your-organization
ADO_ORG_URL=https://dev.azure.com/your-organization
ADO_PAT=your-personal-access-token
ADO_PROJECT=your-project-name

# Comma-separated list of team names to load developers from
# If not set, loads members from all teams in the project
ADO_TEAMS=AssetMgmt Conversion

# Server Configuration
SERVER_PORT=8090
